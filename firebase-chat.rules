rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /enemPrivateRooms/{roomId} {
      function signed() {
        return request.auth != null;
      }
      function participant() {
        return signed() && request.auth.uid in resource.data.members;
      }
      allow get: if signed();
      allow list: if false;
      allow create: if signed()
        && roomId.matches('^[0-9a-f]{24}$')
        && request.resource.data.keys().hasOnly(['members', 'createdAt'])
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdAt == request.time;
      allow update: if signed()
        && resource.data.members is list
        && resource.data.members.size() == 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members == [resource.data.members[0], request.auth.uid]
        && request.auth.uid != resource.data.members[0];
      allow delete: if false;
      match /messages/{messageId} {
        function member() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/enemPrivateRooms/$(roomId)).data.members;
        }
        allow get, list: if member();
        allow create: if member()
          && request.resource.data.keys().hasOnly(['uid', 'text', 'imageData', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (
            (!request.resource.data.keys().hasAny(['imageData'])
              && request.resource.data.text.size() > 0)
            || (request.resource.data.keys().hasAny(['imageData'])
              && request.resource.data.text == ''
              && request.resource.data.imageData is string
              && request.resource.data.imageData.size() <= 180000
              && request.resource.data.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
          )
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
