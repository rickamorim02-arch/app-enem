rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /enemPrivateRooms/{roomId} {
   function signed() { return request.auth != null; }
   function members() { return resource.data.members; }
   allow get: if signed();
   allow list: if false;
   allow create: if signed()
     && roomId.matches('^[0-9a-f]{24}$')
     && request.resource.data.keys().hasOnly(['members','createdAt'])
     && request.resource.data.members == [request.auth.uid]
     && request.resource.data.createdAt == request.time;
   allow update: if signed()
     && resource.data.members is list && resource.data.members.size() == 1
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
     && request.resource.data.members == [resource.data.members[0],request.auth.uid]
     && request.auth.uid != resource.data.members[0];
   allow delete: if false;
   match /messages/{messageId} {
    function participant() { return request.auth != null && request.auth.uid in get(/databases/$(database)/documents/enemPrivateRooms/$(roomId)).data.members; }
    allow get,list: if participant();
    allow create: if participant()
      && request.resource.data.keys().hasOnly(['uid','text','createdAt'])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.text is string
      && request.resource.data.text.size() > 0
      && request.resource.data.text.size() <= 2000
      && request.resource.data.createdAt == request.time;
    allow update,delete: if false;
   }
  }
 }
}